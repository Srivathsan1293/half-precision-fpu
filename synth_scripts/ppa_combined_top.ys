# Combined Top-Level PPA (fpu_test)
# The `map -D ${ABC_DLY_PS}` delay target is the default; run_bench.sh substitutes a
# sweep value and redirects write_verilog into synth_outputs/_bench/.
read_verilog -sv src/fpu_modules.sv
read_verilog -sv src/fpu_FMUL.sv
read_verilog -sv src/fpu_FADDSUB.sv
read_verilog -sv src/fpu_FDIV.sv
read_verilog -sv src/fdiv_datapath_blocks.sv
read_verilog -sv src/fpu_test.sv
synth -top fpu_test -flatten
read_liberty -lib sky130_fd_sc_hd__tt_025C_1v80.lib
dfflibmap -liberty sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty sky130_fd_sc_hd__tt_025C_1v80.lib -script "+strash;ifraig;scorr;dc2;dretime;strash;&get -n;&dch -f;&nf -v;&put;mfs2;strash;&get -n;&dch -f;&nf -v;&put;map -D ${ABC_DLY_PS}"
clean
stat -liberty sky130_fd_sc_hd__tt_025C_1v80.lib
write_verilog -noattr synth_outputs/fpu_test_synth.v
