# FPU PCPI (slow-slow) PPA — fpu_pcpi.sv top with 1-cycle latency contract for FADD/FMUL
read_verilog -sv src/fpu_modules.sv
read_verilog -sv src/fpu_FMUL.sv
read_verilog -sv src/fpu_FADDSUB.sv
read_verilog -sv src/fpu_FDIV.sv
read_verilog -sv src/fdiv_datapath_blocks.sv
read_verilog -sv src/fpu_test.sv
read_verilog -sv src/fpu_pcpi.sv
synth -top fpu_pcpi -flatten
read_liberty sky130_fd_sc_hd__ff_n40C_1v95.lib
dfflibmap -liberty sky130_fd_sc_hd__ff_n40C_1v95.lib
abc -liberty sky130_fd_sc_hd__ff_n40C_1v95.lib -script "+strash;ifraig;scorr;dc2;dretime;strash;&get -n;&dch -f;&nf -v;&put;mfs2;strash;&get -n;&dch -f;&nf -v;&put;map -D 9000"
clean
stat -liberty sky130_fd_sc_hd__ff_n40C_1v95.lib
write_verilog -noattr synth_outputs/PCPI_synth_ff.v
