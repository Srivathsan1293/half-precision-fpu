# Division (DIV) PPA - Nangate45, keep ROM as black box
read_verilog -sv src/fpu_modules.sv
read_verilog -sv src/fpu_FDIV.sv
blackbox reciprocal_rom
synth -top DIV -flatten
read_liberty -lib NangateOpenCellLibrary_typical.lib
dfflibmap -liberty NangateOpenCellLibrary_typical.lib
abc -liberty NangateOpenCellLibrary_typical.lib
clean
stat -liberty NangateOpenCellLibrary_typical.lib
write_verilog synth_outputs/DIV_synth_nangate45.v
setundef -zero
splitnets
sta
