# fpu_pcpi PPA (PCPI wrapper + state machine + FPU datapaths)
# Top module is src/fpu_pcpi.sv (3-state FSM + fpu_test datapath instance).
# Same mfs2 ABC mapping script as the other PPA flows (map -D 9000).
read_verilog -sv src/fpu_modules.sv
read_verilog -sv src/fpu_FMUL.sv
read_verilog -sv src/fpu_FADDSUB.sv
read_verilog -sv src/fpu_FDIV.sv
read_verilog -sv src/fpu_test.sv
read_verilog -sv src/fpu_pcpi.sv
synth -top fpu_pcpi -flatten
read_liberty -lib sky130_fd_sc_hd__tt_025C_1v80.lib
dfflibmap -liberty sky130_fd_sc_hd__tt_025C_1v80.lib
abc -liberty sky130_fd_sc_hd__tt_025C_1v80.lib -script "+strash;ifraig;scorr;dc2;dretime;strash;&get -n;&dch -f;&nf -v;&put;mfs2;strash;&get -n;&dch -f;&nf -v;&put;map -D 9000"
clean
stat -liberty sky130_fd_sc_hd__tt_025C_1v80.lib
write_verilog -noattr synth_outputs/fpu_pcpi_synth.v
